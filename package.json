{
  "name": "kliplan",
  "version": "0.1.0",
  "private": true,
  "description": "Emlak ilanından otomatik dikey tanıtım videosu üreten komut satırı aracı",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit && npm run typecheck -w @kliplan/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "dogrula": "tsx src/cli/dogrula.ts",
    "studio": "tsx src/cli/studio.ts",
    "render:ornek": "tsx src/cli/ornekRender.ts",
    "tema:onizleme": "tsx src/cli/temaOnizleme.ts",
    "senaryo": "tsx src/cli/senaryo.ts",
    "ses": "tsx src/cli/ses.ts",
    "video": "tsx src/cli/video.ts",
    "kullanici-ekle": "tsx src/cli/kullaniciEkle.ts",
    "kullanici-sil": "tsx src/cli/kullaniciSil.ts",
    "ofis-sil": "tsx src/cli/ofisSil.ts",
    "temizlik": "tsx src/cli/temizlik.ts",
    "yedek": "tsx src/cli/yedek.ts",
    "muzik:kutuphane": "tsx src/cli/muzikKutuphanesi.ts",
    "db:uret": "drizzle-kit generate",
    "db:uygula": "drizzle-kit migrate",
    "web": "npm run dev -w @kliplan/web",
    "worker": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@google/genai": "2.31.0",
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/layout-utils": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "better-auth": "1.7.17",
    "bullmq": "6.4.2",
    "commander": "15.0.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "mediabunny": "1.64.0",
    "microsoft-cognitiveservices-speech-sdk": "1.52.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "workspaces": [
    "web"
  ]
}
